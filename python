# ---------------------------- CONFIGURATION ----------------------------

MODEL_NAME = "yolov8n.pt"
MODEL_CANDIDATES = ["yolov8n.pt", "yolov8s.pt", "yolov8m.pt"]
CONFIDENCE = 0.25
IMAGE_SIZE = 640
TRACKER = "bytetrack.yaml"

ENABLE_LINE_COUNT = True
LINE_POSITION = 0.60       # horizontal line at 60% of frame height
SAVE_ANNOTATED_VIDEO = True
OUTPUT_DIR = "output"

VEHICLE_CLASSES = {
    2: "Car",
    3: "Motorcycle",
    5: "Bus",
    7: "Truck",
}

ALL_CLASSES = {
    0: "Person",
    1: "Bicycle",
    2: "Car",
    3: "Motorcycle",
    5: "Bus",
    7: "Truck",
    15: "Cat",
    16: "Dog",
    67: "Mobile Phone",
}


def setup():
    os.makedirs(OUTPUT_DIR, exist_ok=True)


def save_fig(fig, filename):
    fig.tight_layout()
    fig.savefig(os.path.join(OUTPUT_DIR, filename), dpi=200, bbox_inches="tight")
    plt.close(fig)


def choose_source(choice):
    if choice == "1":
        if sys.platform.startswith("win"):
            cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)
        else:
            cap = cv2.VideoCapture(0)
        cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
        return cap, "webcam"

    path = input("Enter video path (example: videos.mp4): ").strip().strip('"')
    if not path:
        path = "videos.mp4"
    if not os.path.isfile(path):
        print(f"ERROR: Video not found: {path}")
        return None, None
    return cv2.VideoCapture(path), os.path.splitext(os.path.basename(path))[0]


def draw_stats_panel(frame, lines):
    h, w = frame.shape[:2]
    panel_w = min(430, w - 20)
    line_h = 25
    panel_h = 16 + line_h * len(lines)
    overlay = frame.copy()
    cv2.rectangle(overlay, (10, 10), (10 + panel_w, 10 + panel_h), (0, 0, 0), -1)
    cv2.addWeighted(overlay, 0.78, frame, 0.22, 0, frame)
    for i, line in enumerate(lines):
        color = (0, 255, 100) if i == 0 else (245, 245, 245)
        cv2.putText(frame, line, (20, 37 + i * line_h),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.57, color, 2, cv2.LINE_AA)


def create_video_figures(
    sequence_name, classes, detection_counts, track_ids, crossing_ids,
    objects_per_frame, fps_per_frame, frame_count, elapsed,
    confidence_values, line_enabled
):
    setup()
    class_names = [classes[cid] for cid in classes]
    detections = [detection_counts[cid] for cid in classes]
    tracklets = [len(track_ids[cid]) for cid in classes]
    crossings = [len(crossing_ids[cid]) for cid in classes]

    avg_fps = frame_count / elapsed if elapsed > 0 else 0.0
    avg_conf = float(np.mean(confidence_values)) if confidence_values else 0.0
    total_detections = int(sum(detections))
    total_tracklets = int(sum(tracklets))
    total_crossings = int(sum(crossings))

    # Store raw, auditable measurements.
    pd.DataFrame({
        "Class": class_names,
        "Detection boxes": detections,
        "Unique track IDs": tracklets,
        "Virtual-line crossings": crossings if line_enabled else ["N/A"] * len(classes),
    }).to_csv(os.path.join(OUTPUT_DIR, "class_statistics.csv"), index=False)

    frame_df = pd.DataFrame({
        "Frame": np.arange(1, len(objects_per_frame) + 1),
        "Objects detected": objects_per_frame,
        "Measured processing FPS": fps_per_frame,
    })
    frame_df.to_csv(os.path.join(OUTPUT_DIR, "frame_statistics.csv"), index=False)

    summary = pd.DataFrame([
        ["Sequence/video", sequence_name],
        ["Frames processed", frame_count],
        ["Video processing duration (seconds)", round(elapsed, 2)],
        ["Average processing FPS", round(avg_fps, 2)],
        ["Average detection confidence", round(avg_conf, 4)],
        ["Total detection boxes across frames", total_detections],
        ["Average objects per frame", round(float(np.mean(objects_per_frame)), 2)
         if objects_per_frame else 0],
        ["Maximum objects in one frame", max(objects_per_frame)
         if objects_per_frame else 0],
        ["Unique tracked IDs / tracklets", total_tracklets],
        ["Virtual-line crossing IDs", total_crossings if line_enabled else "Disabled"],
    ], columns=["Metric", "Value"])
    summary.to_csv(os.path.join(OUTPUT_DIR, "video_summary.csv"), index=False)

    # FIGURE 4-style: class/tracklet distribution + frequency histogram.
    fig, axes = plt.subplots(1, 2, figsize=(13, 5))
    axes[0].bar(class_names, tracklets, color="lightsteelblue", edgecolor="black")
    axes[0].set_title("Class Label Distribution (Unique Track IDs)")
    axes[0].set_xlabel("Classes")
    axes[0].set_ylabel("Number of tracklets")
    axes[0].tick_params(axis="x", rotation=35)
    axes[0].grid(axis="y", alpha=0.25)

    if objects_per_frame:
        bins = min(20, max(5, int(np.sqrt(len(objects_per_frame)))))
        axes[1].hist(objects_per_frame, bins=bins, density=True,
                     color="indianred", edgecolor="white")
    axes[1].set_title("Number of Detected Objects Frequency per Frame")
    axes[1].set_xlabel("Number of objects per frame")
    axes[1].set_ylabel("Frequency (density)")
    axes[1].grid(axis="y", alpha=0.25)
    save_fig(fig, "figure_4_class_distribution_and_frequency.png")

    # Sequence-level statistics, analogous to the supplied sequence chart.
    fig, ax1 = plt.subplots(figsize=(11, 5))
    ax1.bar([sequence_name], [frame_count], color="lightcoral", alpha=0.8)
    ax1.set_ylabel("Number of frames", color="firebrick")
    ax1.set_title("Video Sequence Statistics: Frames and Moving Objects")
    ax1.grid(axis="y", alpha=0.2)
    ax2 = ax1.twinx()
    ax2.plot([sequence_name], [total_detections], marker="o",
             linewidth=2, color="steelblue")
    ax2.set_ylabel("Detection boxes across all frames", color="steelblue")
    save_fig(fig, "figure_5_sequence_statistics.png")

    # FIGURE 6-style: real measured per-frame FPS.
    fig, ax = plt.subplots(figsize=(11, 4.8))
    if fps_per_frame:
        ax.plot(np.arange(1, len(fps_per_frame) + 1), fps_per_frame,
                color="forestgreen", linewidth=1.2, label="Measured FPS")
        ax.axhline(avg_fps, color="firebrick", linestyle="--",
                   label=f"Average: {avg_fps:.2f} FPS")
    ax.set_title("Real-Time FPS Performance")
    ax.set_xlabel("Frame number")
    ax.set_ylabel("Frames per second")
    ax.legend()
    ax.grid(alpha=0.25)
    save_fig(fig, "figure_6_realtime_fps.png")

    # Confidence distribution (useful supporting research figure).
    fig, ax = plt.subplots(figsize=(8, 4.5))
    if confidence_values:
        ax.hist(confidence_values, bins=20, color="slateblue", edgecolor="white")
    ax.set_title("Detection Confidence Distribution")
    ax.set_xlabel("Confidence score")
    ax.set_ylabel("Number of detections")
    ax.grid(axis="y", alpha=0.2)
    save_fig(fig, "detection_confidence_distribution.png")

    print("\n" + "=" * 65)
    print("VIDEO EXPERIMENT SUMMARY")
    print("=" * 65)
    print(summary.to_string(index=False))
    print("\nCLASS-WISE STATISTICS")
    print(pd.read_csv(os.path.join(OUTPUT_DIR, "class_statistics.csv")).to_string(index=False))
    print(f"\nReports and figures saved in: {os.path.abspath(OUTPUT_DIR)}")


def run_video(choice, model, mode):
    classes = VEHICLE_CLASSES if mode == "1" else ALL_CLASSES
    class_ids = list(classes)
    cap, sequence_name = choose_source(choice)
    if cap is None or not cap.isOpened():
        print("ERROR: Could not open camera/video.")
        if cap is not None:
            cap.release()
        return

    fps_source = cap.get(cv2.CAP_PROP_FPS)
    if not fps_source or fps_source <= 0 or fps_source > 240:
        fps_source = 25.0

    writer = None
    track_ids = {cid: set() for cid in class_ids}
    crossing_ids = {cid: set() for cid in class_ids}
    detection_counts = {cid: 0 for cid in class_ids}
    confidence_values = []
    previous_centres = {}
    objects_per_frame = []
    fps_per_frame = []
    frame_count = 0
    tracking_active = True
    start_time = time.time()

    print("\nDetection started. Press Q to stop.")
    try:
        while True:
            ok, frame = cap.read()
            if not ok:
                print("End of video or frame read failed.")
                break

            frame_start = time.perf_counter()
            height, width = frame.shape[:2]
            line_y = int(height * LINE_POSITION)

            if SAVE_ANNOTATED_VIDEO and writer is None:
                out_path = os.path.join(OUTPUT_DIR, f"{sequence_name}_annotated.mp4")
                fourcc = cv2.VideoWriter_fourcc(*"mp4v")
                writer = cv2.VideoWriter(out_path, fourcc, fps_source, (width, height))

            if tracking_active:
                try:
                    results = model.track(
                        source=frame, persist=True, conf=CONFIDENCE,
                        imgsz=IMAGE_SIZE, classes=class_ids,
                        tracker=TRACKER, verbose=False
                    )
                except Exception as exc:
                    warnings.warn(f"Tracking failed; continuing with detection only: {exc}")
                    tracking_active = False
                    results = model.predict(
                        source=frame, conf=CONFIDENCE,
                        imgsz=IMAGE_SIZE, classes=class_ids, verbose=False
                    )
            else:
                results = model.predict(
                    source=frame, conf=CONFIDENCE,
                    imgsz=IMAGE_SIZE, classes=class_ids, verbose=False
                )

            result = results[0]
            annotated = result.plot(line_width=2, labels=True, conf=True)
            frame_class_counts = {cid: 0 for cid in class_ids}
            boxes = result.boxes

            if boxes is not None:
                for box in boxes:
                    cid = int(box.cls[0].item())
                    score = float(box.conf[0].item())
                    if cid not in classes:
                        continue

                    frame_class_counts[cid] += 1
                    detection_counts[cid] += 1
                    confidence_values.append(score)

                    if tracking_active and box.id is not None:
                        tid = int(box.id[0].item())
                        track_ids[cid].add(tid)
                        x1, y1, x2, y2 = box.xyxy[0].tolist()
                        center = (int((x1 + x2) / 2), int((y1 + y2) / 2))

                        # Count each track ID once when it crosses the virtual line.
                        old = previous_centres.get(tid)
                        if ENABLE_LINE_COUNT and old is not None:
                            if ((old[1] < line_y <= center[1]) or
                                    (old[1] > line_y >= center[1])):
                                crossing_ids[cid].add(tid)
                        previous_centres[tid] = center

            object_count = sum(frame_class_counts.values())
            objects_per_frame.append(object_count)
            frame_count += 1

            elapsed_frame = time.perf_counter() - frame_start
            measured_fps = 1.0 / elapsed_frame if elapsed_frame > 0 else 0.0
            fps_per_frame.append(measured_fps)

            if ENABLE_LINE_COUNT:
                cv2.line(annotated, (0, line_y), (width, line_y), (0, 255, 255), 2)
                cv2.putText(annotated, "COUNTING LINE", (max(10, width - 230),
                            max(25, line_y - 10)), cv2.FONT_HERSHEY_SIMPLEX,
                            0.65, (0, 255, 255), 2)

            unique_total = sum(len(v) for v in track_ids.values())
            crossing_total = sum(len(v) for v in crossing_ids.values())
            avg_conf = float(np.mean(confidence_values)) if confidence_values else 0.0

            panel = [
                f"Objects in current frame: {object_count}",
                f"Frames processed: {frame_count}",
                f"Unique track IDs: {unique_total}" if tracking_active else "Tracking: OFF",
            ]
            for cid, name in classes.items():
                panel.append(f"{name}: {frame_class_counts[cid]}")
            if ENABLE_LINE_COUNT and tracking_active:
                panel.append(f"Line crossing IDs: {crossing_total}")
            panel.extend([f"Average confidence: {avg_conf:.2f}",
                          f"Processing FPS: {measured_fps:.1f}"])
            draw_stats_panel(annotated, panel)

            if writer is not None:
                writer.write(annotated)

            cv2.imshow("YOLOv8 Research-Style Object Detection", annotated)
            if cv2.waitKey(1) & 0xFF == ord("q"):
                print("Stopped by user.")
                break

    finally:
        cap.release()
        if writer is not None:
            writer.release()
        cv2.destroyAllWindows()

    if frame_count == 0:
        print("No frames were processed.")
        return

    total_elapsed = time.time() - start_time
    create_video_figures(
        sequence_name, classes, detection_counts, track_ids, crossing_ids,
        objects_per_frame, fps_per_frame, frame_count, total_elapsed,
        confidence_values, ENABLE_LINE_COUNT
    )
    if SAVE_ANNOTATED_VIDEO:
        print(f"Annotated video: {os.path.join(OUTPUT_DIR, sequence_name + '_annotated.mp4')}")


def evaluate_models():
    data_yaml = input(
        "Enter labelled dataset YAML path (Enter for coco128.yaml): "
    ).strip() or "coco128.yaml"

    rows = []
    for model_name in MODEL_CANDIDATES:
        print(f"\nValidating {model_name} on {data_yaml} ...")
        model = YOLO(model_name)
        metrics = model.val(
            data=data_yaml, imgsz=IMAGE_SIZE, conf=0.001,
            iou=0.6, plots=False, verbose=False
        )
        speed = metrics.speed
        total_ms = max(sum(speed.values()), 0.001)
        params_m = sum(p.numel() for p in model.model.parameters()) / 1e6

        rows.append({
            "Model": model_name.replace(".pt", ""),
            "Parameters (M)": round(params_m, 2),
            "Precision": float(metrics.box.mp),
            "Recall": float(metrics.box.mr),
            "mAP50": float(metrics.box.map50),
            "mAP50-95": float(metrics.box.map),
            "Validation time (ms/image)": total_ms,
            "Approx. validation images/sec": 1000.0 / total_ms,
        })

    df = pd.DataFrame(rows)
    df.to_csv(os.path.join(OUTPUT_DIR, "model_comparison.csv"), index=False)
    print("\nMODEL COMPARISON")
    print(df.round(4).to_string(index=False))

    # Comparison figure: accuracy metrics and speed are kept in separate panels.
    fig, axes = plt.subplots(1, 2, figsize=(13, 5))
    x = np.arange(len(df))
    width = 0.2
    for i, metric in enumerate(["Precision", "Recall", "mAP50", "mAP50-95"]):
        axes[0].bar(x + (i - 1.5) * width, df[metric], width, label=metric)
    axes[0].set_xticks(x)
    axes[0].set_xticklabels(df["Model"])
    axes[0].set_ylim(0, 1.05)
    axes[0].set_ylabel("Score")
    axes[0].set_title("YOLO Model Accuracy Comparison")
    axes[0].legend(fontsize=8)
    axes[0].grid(axis="y", alpha=0.2)

    axes[1].bar(df["Model"], df["Approx. validation images/sec"],
                color="steelblue")
    axes[1].set_ylabel("Images per second (approx.)")
    axes[1].set_title("YOLO Model Validation Speed")
    axes[1].grid(axis="y", alpha=0.2)
    save_fig(fig, "figure_9_model_comparison.png")

    print("\nSaved output/model_comparison.csv")
    print("Saved output/figure_9_model_comparison.png")
    print("Note: mAP50 and mAP50-95 are AP metrics at IoU thresholds,")
    print("not a standalone mean-IoU score. Validation speed is not")
    print("the same as live-video FPS.")


def plot_training_results():
    """Plot real Ultralytics results.csv from a previous training run."""
    path = input(
        "Enter path to Ultralytics results.csv (example: "
        "runs/detect/train/results.csv): "
    ).strip().strip('"')

    if not path or not os.path.isfile(path):
        print("Could not find results.csv. No training curves were created.")
        return

    df = pd.read_csv(path)
    df.columns = [c.strip() for c in df.columns]
    epoch_col = "epoch" if "epoch" in df.columns else None
    if epoch_col is None:
        print("This CSV has no epoch column; cannot plot epoch curves.")
        return

    # Only plot metrics that genuinely exist in this training log.
    groups = {
        "Precision": ["metrics/precision(B)"],
        "Recall": ["metrics/recall(B)"],
        "Average Precision (mAP50)": ["metrics/mAP50(B)"],
        "mean AP (mAP50-95)": ["metrics/mAP50-95(B)"],
        "Training losses": [
            "train/box_loss", "train/cls_loss", "train/dfl_loss"
        ],
        "Validation losses": [
            "val/box_loss", "val/cls_loss", "val/dfl_loss"
        ],
    }

    made = 0
    for title, columns in groups.items():
        available = [c for c in columns if c in df.columns]
        if not available:
            continue
        fig, ax = plt.subplots(figsize=(8, 4.5))
        for col in available:
            ax.plot(df[epoch_col], df[col], label=col)
        ax.set_title(f"{title} over Training Epochs")
        ax.set_xlabel("Epoch")
        ax.set_ylabel("Value")
        ax.grid(alpha=0.25)
        ax.legend(fontsize=8)
        filename = "training_" + str(made + 1) + ".png"
        save_fig(fig, filename)
        made += 1

    if made:
        print(f"Created {made} training-curve figure(s) from actual results.csv.")
        print("No FPS or tracking-accuracy epoch curves are invented.")
    else:
        print("No supported metric columns were found in this results.csv.")


def main():
    setup()
    print("\n===== YOLOv8 OBJECT DETECTION & RESEARCH ANALYSIS =====")
    print("1. Live camera")
    print("2. Video file")
    print("3. Compare YOLOv8 models on a labelled dataset (P/R/mAP)")
    print("4. Plot curves from an existing YOLO training results.csv")

    choice = input("Choose 1, 2, 3, or 4: ").strip()

    if choice in ("1", "2"):
        print("\nDetection mode:")
        print("1. Vehicles only")
        print("2. Selected COCO objects")
        mode = input("Choose 1 or 2: ").strip()
        if mode not in ("1", "2"):
            print("Invalid mode.")
            return
        print(f"\nLoading {MODEL_NAME} ...")
        model = YOLO(MODEL_NAME)
        run_video(choice, model, mode)
    elif choice == "3":
        evaluate_models()
    elif choice == "4":
        plot_training_results()
    else:
        print("Invalid menu option.")


if __name__ == "__main__":
    main()
